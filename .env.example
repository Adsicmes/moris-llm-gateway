# MorisLLMGateway 运行环境示例
# 复制为 .env 后再填写；.env 已被 .gitignore 忽略，禁止提交真实值。
# chmod 600 .env

MORIS_HOST=0.0.0.0
MORIS_PORT=8787
MORIS_DATA_DIR=/app/data
MORIS_BACKUP_DIR=/app/backups

# 32 字节随机数的 base64。生成方式见 docs/deployment.md，禁止使用示例值。
MORIS_MASTER_KEY=

MORIS_ADMIN_USERNAME=admin
# 首次启动至少 12 个字符；仅在首次初始化管理员时使用，禁止默认密码。
MORIS_ADMIN_PASSWORD=

# 经 Caddy HTTPS 对外时必须为 true；仅本机 HTTP 调试时临时设为 false。
MORIS_SECURE_COOKIE=true

MORIS_ADMIN_DIST=/app/apps/admin/dist
